# ---------------------------------------------------------------------------
# KaziOS environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# NODE_ENV is deliberately absent. Next.js sets it itself — development for
# `next dev`, production for `next build` and `next start`, test under Vitest —
# and setting it here overrides that: `NODE_ENV=development` in .env.local makes
# `next build` emit a development React runtime into a production build, which
# fails prerendering with "Cannot read properties of null (reading 'useContext')".
APP_URL=http://localhost:3000

# 32+ byte random string used to sign session cookies and CSRF tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- Database --------------------------------------------------------------
# Any PostgreSQL 14+ instance. On Supabase use the *pooled* connection string
# for the app and the direct string for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kazios
# Set to "require" against managed Postgres (Supabase/Neon/RDS).
DATABASE_SSL=disable
DATABASE_MAX_CONNECTIONS=10

# Separate database for the integration suites. They TRUNCATE every table
# between tests, so this must never point at a database you care about. Unset,
# the integration suites skip themselves and `npm test` still passes. The schema
# is migrated automatically before the suites run.
TEST_DATABASE_URL=

# --- AI --------------------------------------------------------------------
# Provider is pluggable: "anthropic" | "mock".
# "mock" is deterministic and offline — used by tests and local development.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=4096
# Hard ceiling on AI spend per user per day (requests, not tokens).
AI_DAILY_REQUEST_LIMIT=60

# --- Storage ---------------------------------------------------------------
# "local" writes to ./storage-uploads (dev only). "supabase" uses Supabase Storage.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage-uploads
SUPABASE_URL=
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kazios

# --- Payments --------------------------------------------------------------
# "mock" simulates the full ledger without moving money. "mpesa" is pending
# integration — see docs/PAYMENTS.md.
PAYMENT_PROVIDER=mock
PLATFORM_FEE_BPS=1000
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox

# --- Notifications ---------------------------------------------------------
# "console" logs instead of sending (dev). "smtp" sends real email.
NOTIFICATION_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM="KaziOS <no-reply@kazios.co.ke>"

# --- Analytics -------------------------------------------------------------
# Events always land in the analytics_events table; PostHog is an extra sink.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Seeding ---------------------------------------------------------------
# Password assigned to the seeded demo accounts. Development only.
SEED_DEMO_PASSWORD=KaziOS-demo-2025

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for /api/cron/housekeeping. Vercel sends it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=
